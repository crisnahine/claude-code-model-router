    family-names: Nahine
version: "0.2.0"
date-released: "2026-11-25"
license: Apache-2.0
repository-code: "https://github.com/crisnahine/claude-code-model-router"
url: "https://github.com/crisnahine/claude-code-model-router"
keywords:
  - Claude Code
  - Claude Code plugin
  - model routing
  - subagents
  - cost per solved task
